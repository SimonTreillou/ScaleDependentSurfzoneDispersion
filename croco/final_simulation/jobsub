#!/bin/bash
#SBATCH -J R3_VS_1
#SBATCH --partition=serc
#SBATCH -o R3_VS_1-%j.out
#SBATCH -e R3_VS_1-%j.err
#SBATCH --time=100:00:00
#SBATCH --nodes=5
#SBATCH --ntasks=120
#SBATCH --ntasks-per-node=24
#SBATCH --ntasks-per-core=1
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=2G
#SBATCH --constraint="CLASS:SH3_CBASE|CLASS:SH4_CPERF|CLASS:SH4_CBASE"
#SBATCH --mail-user=treillou@stanford.edu
#SBATCH --mail-type=ALL

module purge
module load gcc openmpi netcdf hdf5 netcdf-c netcdf-fortran

export croco=/home/groups/bakercm/CROCO/croco
export configs=/home/users/treillou/Configs
homedir=$SLURM_SUBMIT_DIR
workdir=$SCRATCH/CLARK_PROD/R3_VS_tracer_keps

count=1
while [ -d "$workdir" ]; do
  echo "Directory $workdir already exists."
  count=$((count + 1))
  workdir="$SCRATCH/CLARK_PROD/R3_VS_spinup_keps_$count"
done

if [ ! -d "$SCRATCH/CLARK_PROD" ]; then
  mkdir $SCRATCH/CLARK_PROD
fi
mkdir $workdir
echo "$SLURM_JOB_ID" > $workdir/jobid

cp croco*    $workdir
cp *.nc      $workdir
cp *.h       $workdir
cp job*      $workdir
cp *.F       $workdir
cp *.in      $workdir
cp *.txt     $workdir
mv ./Compile $workdir
rm namelist_* ncjoin partit kRGB*
rm -r MUSTANG_NAMELIST
mv ./Compile $workdir
cd $workdir

echo "Launching CROCO..."
mpirun -np 120 ./croco croco.in > croco.out
echo "... CROCO done"
cp croco.out $homedir
